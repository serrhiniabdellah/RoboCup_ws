<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- 
  Package.xml ROS 2 - Métadonnées du paquet RMS Rescue
  
  Répertorie toutes les dépendances build et runtime nécessaires au projet.
  Format : ROS 2 package format version 3 (Humble/Jazzy compatible)
-->
<package format="3">
  <!-- Identification du paquet -->
  <name>rms_lidar</name>
  <version>0.0.0</version>
  <description>RoboCup RMS Lidar module — ROS 2 Jazzy</description>

  <!-- Maintenance -->
  <maintainer email="robocup@isty.fr">RoboCup MT5 ISTY</maintainer>
  <license>TODO</license>

  <!-- 
    Dépendances de build : Outils de compilation
    - ament_cmake : Système de build CMake pour ROS 2
  -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 
    Dépendances run-time : Paquets utilisés à la compilation ET runtime
    
    Interfaces ROS :
    - rclcpp : Client C++ ROS 2
    - std_msgs : Messages standards (String, Int32, etc.)
    - sensor_msgs : Messages capteurs (Image, PointCloud, LaserScan)
    - geometry_msgs : Messages géométrie (Pose, Twist, TransformStamped)
    - nav_msgs : Messages navigation (Path, OccupancyGrid)
    
    Transform & Localisation :
    - tf2 : Bibliothèque transforms (repère robot, static)
    - tf2_ros : Intégration TF2 avec ROS (broadcaster, listener)
    - tf2_geometry_msgs : Conversion géométrie ↔ TF2
    
    Vision & Images :
    - image_transport : Transport efficace images (compression)
    - cv_bridge : Bridge OpenCV ↔ ROS messages
  -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>

  <!-- Export : Configuration paquet speciale ROS 2 -->
  <export>
    <build_type>ament_cmake</build_type>  <!-- Utilise CMake (pas ament_python) -->
  </export>
</package>
